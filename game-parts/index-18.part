`
varying vec3 vDir;
void main(){
  vDir = normalize(position);
  vec4 p = modelViewMatrix * vec4(position,1.0);
  gl_Position = projectionMatrix * p;
  gl_Position.z = gl_Position.w; // always at far plane
}`,zx=`
varying vec3 vDir;
uniform vec3 topColor, horizonColor, groundColor, glowColor, sunColor, cloudColor;
uniform vec3 sunDir;
uniform float glowBand, stars, cloudCover, moon, time;
float hash13(vec3 p){ p = fract(p*0.1031); p += dot(p, p.zyx+31.32); return fract((p.x+p.y)*p.z); }
float hash12(vec2 p){ vec3 p3 = fract(vec3(p.xyx)*0.1031); p3 += dot(p3, p3.yzx+33.33); return fract((p3.x+p3.y)*p3.z); }
float noise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(hash12(i),hash12(i+vec2(1,0)),f.x), mix(hash12(i+vec2(0,1)),hash12(i+vec2(1,1)),f.x), f.y); }
float fbm(vec2 p){ float a=.5, s=0.; for(int i=0;i<5;i++){ s+=a*noise(p); p*=2.03; a*=.5; } return s; }
void main(){
  vec3 d = normalize(vDir);
  float h = d.y;
  vec3 col;
  if (h >= 0.0) col = mix(horizonColor, topColor, pow(clamp(h,0.0,1.0), 0.42));
  else col = mix(horizonColor, groundColor, clamp(-h*6.0,0.0,1.0));
  float sd = max(dot(d, sunDir), 0.0);
  // horizon glow towards the sun / city
  float toSun = pow(sd, 3.0);
  col += glowColor * exp(-abs(h)*9.0) * glowBand * (0.35 + 0.65*toSun);
  col += glowColor * pow(sd, 10.0) * 0.35 * (1.0 - moon);
  // sun / moon disc
  if (moon < 0.5) {
    col += sunColor * (pow(sd, 900.0) * 18.0 + pow(sd, 60.0) * 0.5);
  } else {
    float disc = smoothstep(0.9993, 0.9996, sd);
    col = mix(col, vec3(0.85,0.9,1.0)*1.6, disc);
    col += vec3(0.4,0.5,0.8) * pow(sd, 60.0) * 0.25;
  }
  // stars
  if (stars > 0.01 && h > 0.0) {
    vec3 sp = d * 180.0; vec3 ip = floor(sp);
    float r = hash13(ip);
    vec3 fp = fract(sp) - 0.5;
    float star = step(0.9962, r) * smoothstep(0.35, 0.0, length(fp)) * (0.5 + 0.5*hash13(ip+7.0));
    col += vec3(0.9,0.95,1.0) * star * stars * smoothstep(0.02, 0.35, h) * 1.6;
  }
  // clouds on a high plane
  if (h > 0.01 && cloudCover > 0.01) {
    vec2 cp = d.xz / (h + 0.18) * 1.1 + vec2(time*0.004, 0.0);
    float c = fbm(cp * 1.4);
    c = smoothstep(1.0 - cloudCover*0.75, 1.0 - cloudCover*0.2 + 0.05, c);
    float fade = smoothstep(0.01, 0.18, h);
    vec3 cc = cloudColor * (0.55 + 0.6*pow(sd, 2.0));
    col = mix(col, cc, c * fade * 0.75);
  }
  gl_FragColor = vec4(col, 1.0);
